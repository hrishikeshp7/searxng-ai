# ---------------------------------------------------------------------------
# SearXNG AI Environment Configuration
# ---------------------------------------------------------------------------

# Generate secret key: openssl rand -hex 32
SEARXNG_SECRET=

# Public URL (optional, needed if behind reverse proxy or custom domain)
# SEARXNG_BASE_URL=https://search.example.com/

# Port to expose (default 8080)
SEARXNG_PORT=8080

# ---------------------------------------------------------------------------
# AI Overview Configuration
# ---------------------------------------------------------------------------
# OpenAI-compatible API base URL (omit trailing /chat/completions)
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://host.docker.internal:11434/v1
SEARXNG_AI_OVERVIEW_BASE_URL=https://api.openai.com/v1

# API Key for LLM provider
SEARXNG_AI_OVERVIEW_API_KEY=your_api_key_here

# Model name
# Examples:
#   OpenAI:       gpt-4o-mini, gpt-4o
#   Groq:         llama-3.3-70b-versatile
#   OpenRouter:   meta-llama/llama-3.3-70b-instruct:free
#   Ollama:       llama3.2
SEARXNG_AI_OVERVIEW_MODEL=gpt-4o-mini

# Trigger mode:
#   'auto'   - generate overview automatically for informational queries
#   'manual' - show a "Generate overview" button on every query
SEARXNG_AI_OVERVIEW_TRIGGER_MODE=auto
